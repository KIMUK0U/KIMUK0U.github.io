---
import './experience.css';
import { work } from '@/data/profile';
---

<section class="experience" aria-labelledby="experience-heading">
  <div class="container">
    <div class="experience__header">
      <span class="section-label">experience</span>
      <h2 id="experience-heading" style="font-size: var(--text-xl); font-weight: 700; margin-top: var(--space-3);">
        経験・アルバイト
        <span class="en" style="display: block; font-size: var(--text-sm); margin-top: var(--space-2);">work experience</span>
      </h2>
    </div>

    <div class="experience__list">
      {work.map(item => (
        <div class="experience-item">
          <div>
            <p class="experience-item__role">
              {item.role}
              <span class="experience-item__role-en en">{item.role_en}</span>
            </p>
            <div class="experience-item__company">
              <span class="experience-item__company-name">{item.company}</span>
              <span class="experience-item__type en">{item.type_en}</span>
            </div>
          </div>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="experience-item__link"
            aria-label={`${item.company} のウェブサイト`}
          >
            {item.url.replace('https://', '')} →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
