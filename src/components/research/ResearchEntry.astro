---
interface Props {
  id: string;
  title_ja: string;
  title_en: string;
  description: string;
  tags: string[];
  year: string;
  repo?: string;
  privateRepo?: boolean;
  video?: string;
  gif?: { src: string; alt: string };
  award?: string;
  contributed?: boolean;
}

const {
  id, title_ja, title_en, description, tags, year, repo, privateRepo,
  video, gif, award, contributed,
} = Astro.props;
---

<article class="research-entry">
  {video && (
    <div class="research-entry__video">
      <iframe
        src={`https://www.youtube.com/embed/${video}`}
        title={`${title_ja} デモ動画`}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  )}

  {gif && (
    <a
      class="research-entry__video research-entry__gif"
      href={gif.src}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${title_ja} の紹介 GIF（拡大して開く）`}
    >
      <img src={gif.src} alt={gif.alt} width="1120" height="630" loading="lazy" decoding="async" />
    </a>
  )}

  {!video && !gif && (
    <div class="research-entry__video research-entry__media-empty" aria-hidden="true">
      <span>{id}</span>
    </div>
  )}

  <div class="research-entry__body">
    <div class="research-entry__meta">
      <span class="research-entry__year en">[{year}]</span>
      <span class="section-label" aria-hidden="true">{id}</span>
      {contributed && <span class="research-entry__contributed en">contributed</span>}
    </div>

    {award && (
      <div class="research-entry__award">
        <svg viewBox="0 0 16 16" fill="currentColor" width="12" height="12" aria-hidden="true">
          <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
        </svg>
        {award}
      </div>
    )}

    <h3 class="research-entry__title">
      {title_ja}
      <span class="research-entry__title-en en">{title_en}</span>
    </h3>

    <p class="research-entry__description">{description}</p>

    <div class="research-entry__tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>

    <div class="research-entry__footer">
    {privateRepo && !repo && (
      <span class="research-entry__private en">private repository</span>
    )}

    {repo && <a
      href={repo}
      target="_blank"
      rel="noopener noreferrer"
      class="research-entry__link"
      aria-label={`${title_ja} のGitHubリポジトリ`}
    >
      GitHub
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5"/>
        <path fill-rule="evenodd" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0z"/>
      </svg>
    </a>}
    </div>
  </div>
</article>
